{
  "name": "@imagginai/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:mediapipe": "node ../../packages/interacxr/scripts/sync-mediapipe.mjs public/mediapipe",
    "sync:pdfjs": "node scripts/sync-pdfjs.mjs",
    "predev": "pnpm --filter interacxr build && pnpm run sync:mediapipe && pnpm run sync:pdfjs",
    "dev": "vite",
    "dev:https": "pnpm --filter interacxr build && pnpm run sync:mediapipe && pnpm run sync:pdfjs && vite --host --mode https",
    "prebuild": "pnpm --filter interacxr build && pnpm run sync:mediapipe && pnpm run sync:pdfjs",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.118.0",
    "aframe": "1.7.1",
    "aframe-troika-text": "0.14.0",
    "dexie": "4.4.6",
    "interacxr": "workspace:*",
    "pdfjs-dist": "6.4.299",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.173.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.0.3"
  }
}
