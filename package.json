{
  "name": "imagginai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @imagginai/web dev",
    "dev:https": "pnpm --filter @imagginai/web dev:https",
    "dev:api": "pnpm --filter @imagginai/api dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint . --max-warnings 0 && prettier --check . && pnpm -r lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
